# SiteSense 5G — Caddy reverse proxy (automatic HTTPS via Let's Encrypt).
# Caddy fetches + renews the TLS cert automatically, as long as:
#   - sitesense5g.com's DNS A record points to this droplet, and
#   - ports 80 and 443 are open to the internet.
#
# TLS defaults (already applied by Caddy): TLS 1.2/1.3 only, modern AEAD/ECDHE
# ciphers, OCSP stapling, auto HTTP->HTTPS redirect.

sitesense5g.com {
    # Social-media link crawlers (Telegram, Facebook, WhatsApp, LinkedIn,
    # Discord, Slack, X/Twitter, etc.) get a small Open Graph page so pasted
    # links show a rich card; real visitors fall through to the live app.
    @crawlers header_regexp User-Agent (?i)(TelegramBot|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|Discordbot|redditbot|Pinterest|Applebot|SkypeUriPreview|vkShare|Google-InspectionTool|bingbot)

    # 1) The preview image must always serve as the real file (any UA / path-first).
    handle /preview.png {
        root * /srv/preview
        file_server
    }

    # 2) Crawlers on any other path -> the Open Graph preview page.
    handle @crawlers {
        root * /srv/preview
        rewrite * /index.html
        file_server
    }

    # 3) Everyone else -> the live Streamlit dashboard. Login is handled
    #    in-app (see app.py's require_login()) so it gets a branded page
    #    instead of the browser's native basic-auth popup.
    handle {
        reverse_proxy app:8501
    }

    # --- Security headers (defensive hardening) ---------------------------
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    # Note: no strict Content-Security-Policy — Streamlit needs inline scripts.
}

# --- OPTIONAL: public API /docs over HTTPS (uncomment to enable) -----------
# 1. Add a DNS A record  api.sitesense5g.com -> 178.128.24.102
# 2. Uncomment and redeploy (docker compose up -d).
#
